# Copy this file to .env and fill in real values. NEVER commit .env.
#
# Production: inject values from your platform's secret manager (Fly/Render/
# Railway/Vercel env vars, AWS Secrets Manager, Doppler, ...) instead of a file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection used by the app: MUST use a least-privileged, DML-only
# role (see scripts/setup-runtime-role.sql), never the database owner.
DATABASE_URL='postgresql://app_runtime:REPLACE_ME@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full&channel_binding=require'

# Owner/admin connection used ONLY by drizzle-kit (npm run db:generate/migrate/push).
# Prefer the direct (non-pooled) host: remove "-pooler" from the hostname.
# Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL='postgresql://neondb_owner:REPLACE_ME@<host>.<region>.aws.neon.tech/<db>?sslmode=verify-full'

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production | test  (required; no default on purpose)
NODE_ENV=development
PORT=3000
# How many reverse proxies sit in front of the app (0 = none). Wrong values let
# clients spoof X-Forwarded-For and dodge IP rate limits.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
# lax | strict | none  ("none" implies Secure cookies; needed for cross-site frontends)
COOKIE_SAMESITE=lax
# Reject passwords found in known breaches (HaveIBeenPwned, k-anonymity).
# "off" is allowed in development only; production must run with it "on".
PWNED_PASSWORD_CHECK=on

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
# Comma-separated plain origins: scheme + host [+ port], no paths or trailing slash.
# Include the public landing site as well as the admin app: the landing posts
# bookings and reads availability directly from the browser.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Plain origin too (no path): used to build links in emails
CLIENT_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=you@gmail.com
# Google "App Password" (https://myaccount.google.com/apppasswords), not your
# account password. Rotate immediately if it ever lands in a chat/commit.
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Optional; defaults to '"<APP_NAME>" <EMAIL_USER>'
# EMAIL_FROM='"MyApp" <you@gmail.com>'

# ---------------------------------------------------------------------------
# Supabase Storage (admin image uploads)
# ---------------------------------------------------------------------------
# Public bucket used for portfolio, design, and merch images.
# Keep the service-role key server-side only; never expose it to the frontend.
# Leave all three values unset to disable uploads (the API returns 503).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# SUPABASE_STORAGE_BUCKET=your-public-bucket

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# APP_NAME=MyApp
# LOG_LEVEL=info
# off | no-verify | verify  (default: verify in production, off otherwise)
# DB_SSL=verify
# Shared rate-limit store. Required before running more than one instance;
# without it limits are per-process and reset on deploy.
# REDIS_URL=redis://localhost:6379
